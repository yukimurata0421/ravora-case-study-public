[Unit]
Description=Ray local English voice (Kokoro-82M on CUDA)
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=exec
UMask=0077
RuntimeDirectory=ray-kokoro
RuntimeDirectoryMode=0700
EnvironmentFile=-%h/ray-studio/tts.env
ExecStart=%h/ray-studio/scripts/run_local_tts.sh kokoro
ExecStop=/usr/bin/docker stop --time 8 ray-kokoro-tts
TimeoutStopSec=20
Restart=on-failure
RestartSec=15

[Install]
WantedBy=default.target
