# Optional integration settings. The case-study replay and console do not load
# this file, read credentials from the environment, or enable cloud requests.
RAVORA_API_ENABLED=false
RAVORA_STT_API_ENABLED=false
RAVORA_MEMORY_API_ENABLED=false
YOUTUBE_READ_ENABLED=false
RAVORA_CONTEXT_ENABLED=true
RAVORA_RELATIONSHIP_ENABLED=true
RAVORA_CONTEXT_MAX_ITEMS=8
RAVORA_CONTEXT_MAX_CHARS=3600
RAVORA_MEMORY_TTL_DAYS=30
RAVORA_PERSONA=cheeky
RAVORA_PERSONA_FILE=
RAVORA_REPLY_STYLE=brief
RAVORA_VOICE_STT_REGION=asia-northeast1
RAVORA_VOICE_STT_MODEL=long
JEV_MODEL=jev-1.14.0
RAVORA_EARLY_REACTION_ENABLED=true
RAVORA_EARLY_REACTION_STABILITY=0.8
RAVORA_EARLY_REACTION_DEBOUNCE_MS=120
RAVORA_EARLY_REACTION_MAX_REQUESTS=2
RAVORA_VOICE_TTS_VOICE=en-US-Chirp3-HD-Zephyr
GOOGLE_TTS_SPEAKING_RATE=0.96
GOOGLE_TTS_PITCH=2
RAVORA_STT_MONTHLY_AUDIO_SECONDS=43200
RAVORA_MONTHLY_TTS_CHAR_LIMIT=1000000
