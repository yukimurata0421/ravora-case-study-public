# Optional integration settings. The case-study replay and console do not load
# this file, read credentials from the environment, or enable cloud requests.
RAVORA_API_ENABLED=false
RAVORA_STT_API_ENABLED=false
# Opt in to source-backed Japanese and English viewer memories in the cloud studio.
# Set both RAVORA_API_ENABLED and this switch to true in your private .env.
RAVORA_MEMORY_API_ENABLED=false
YOUTUBE_READ_ENABLED=false
RAVORA_CONTEXT_ENABLED=true
RAVORA_RELATIONSHIP_ENABLED=true
RAVORA_CONTEXT_MAX_ITEMS=8
RAVORA_CONTEXT_MAX_CHARS=3600
RAVORA_MEMORY_TTL_DAYS=30
RAVORA_PERSONA=cheeky
RAVORA_PERSONA_FILE=
RAVORA_REPLY_STYLE=normal
RAVORA_VOICE_STT_REGION=asia-northeast1
RAVORA_VOICE_STT_MODEL=long
JEV_MODEL=jev-1.14.0
RAVORA_EARLY_REACTION_ENABLED=true
RAVORA_EARLY_REACTION_STABILITY=0.8
RAVORA_EARLY_REACTION_DEBOUNCE_MS=120
RAVORA_EARLY_REACTION_MAX_REQUESTS=2
RAVORA_VOICE_TTS_VOICE=en-US-Chirp3-HD-Zephyr
GOOGLE_TTS_SPEAKING_RATE=0.96
GOOGLE_TTS_PITCH=2
RAVORA_STT_MONTHLY_AUDIO_SECONDS=43200
RAVORA_MONTHLY_TTS_CHAR_LIMIT=1000000
RAVORA_MONTHLY_REPLY_LLM_USD=7
# Optional episode retrieval modes: off, candidates, jev
RAVORA_SEMANTIC_MEMORY_MODE=off

# Used only by the optional live studio. Store the populated .env with mode 0600.
GEMINI_API_KEY=
JEV_API_KEY=
GOOGLE_TTS_API_KEY=
# Optional Cloud Speech-to-Text. The send switches above remain off by default.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_QUOTA_PROJECT=
GOOGLE_CLOUD_ACCESS_TOKEN=
YOUTUBE_API_KEY=
YOUTUBE_VIDEO_ID=
YOUTUBE_LIVE_CHAT_ID=
YOUTUBE_STREAM_KEY=
YOUTUBE_CHAT_REQUESTS_PER_HOUR=240
YOUTUBE_CHAT_DAILY_UNITS=4800
# Login of the broadcaster whose credentials the scheduler must verify.
RAVORA_TWITCH_CHANNEL=
TWITCH_STREAM_KEY=
TWITCH_RTMPS_URL=rtmps://ingest.global-contribute.live-video.net/app
TWITCH_CHAT_ENABLED=true
RAVORA_TWITCH_JA_TTS=aivis
RAVORA_TWITCH_EN_TTS=kokoro
RAVORA_TWITCH_RECALL_MODE=session
RAVORA_TTS_LANGUAGE_CONFIDENCE=0.80
RAVORA_CHARACTER_ENABLED=true
RAVORA_VOICE_INPUT_LANGUAGE=ja-JP
RAVORA_STT_LANGUAGE=auto
RAVORA_STT_MODEL_PATH=assets/stt/local-model
